{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://katherineseye.com/schemas/synthetic-executive/real-route-calibration-authority.schema.json",
  "title": "Synthetic Executive Real Route Calibration Authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authorityType", "status", "releaseIdentity", "readinessManifestHash", "priorCalibrationFailureResultHash", "providerProfileHash", "billingAttestationHash", "exactModelId", "endpointClass", "calibrationCaseId", "calibrationCaseHash", "calibrationPromptHash", "promptByteCount", "executiveActionSchemaHash", "inputTokenCeiling", "outputTokenCeiling", "maximumProviderCostUsd", "maximumMetadataAccessRequests", "maximumInferenceRequests", "maximumInferenceRetries", "maximumAgentToolCalls", "maximumEngineeringWorkerDispatches", "maximumWallClockDurationMs", "resultRootRelativePath", "singleUseIdentity", "createdAt", "expiresAt", "prohibitedActivities", "authoritySchemaHash", "authorityHash"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "authorityType": {"const": "SYNTHETIC_EXECUTIVE_REAL_ROUTE_CALIBRATION_ONLY"},
    "status": {"const": "AUTHORIZED"},
    "releaseIdentity": {"type": "object", "additionalProperties": false, "required": ["version", "runtimeCommit", "runtimeTree", "sealCommit", "sealTree", "releaseRecordHash"], "properties": {"version": {"const": "1.12.26"}, "runtimeCommit": {"$ref": "#/$defs/gitObject"}, "runtimeTree": {"$ref": "#/$defs/gitObject"}, "sealCommit": {"$ref": "#/$defs/gitObject"}, "sealTree": {"$ref": "#/$defs/gitObject"}, "releaseRecordHash": {"$ref": "#/$defs/hash"}}},
    "readinessManifestHash": {"$ref": "#/$defs/hash"},
    "priorCalibrationFailureResultHash": {"$ref": "#/$defs/hash"},
    "providerProfileHash": {"$ref": "#/$defs/hash"},
    "billingAttestationHash": {"$ref": "#/$defs/hash"},
    "exactModelId": {"const": "gpt-5.6-sol"},
    "endpointClass": {"const": "RESPONSES_API"},
    "calibrationCaseId": {"const": "KE-CAL-001"},
    "calibrationCaseHash": {"$ref": "#/$defs/hash"},
    "calibrationPromptHash": {"$ref": "#/$defs/hash"},
    "promptByteCount": {"type": "integer", "minimum": 1, "maximum": 8000},
    "executiveActionSchemaHash": {"$ref": "#/$defs/hash"},
    "inputTokenCeiling": {"const": 8000},
    "outputTokenCeiling": {"const": 2000},
    "maximumProviderCostUsd": {"const": 0.25},
    "maximumMetadataAccessRequests": {"const": 1},
    "maximumInferenceRequests": {"const": 1},
    "maximumInferenceRetries": {"const": 0},
    "maximumAgentToolCalls": {"const": 0},
    "maximumEngineeringWorkerDispatches": {"const": 0},
    "maximumWallClockDurationMs": {"const": 300000},
    "resultRootRelativePath": {"type": "string", "pattern": "^qualification-results/real-route-calibration-[a-f0-9]{16}$"},
    "singleUseIdentity": {"type": "string", "pattern": "^calibration-use-[a-f0-9]{48}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "prohibitedActivities": {"type": "array", "minItems": 12, "uniqueItems": true},
    "authoritySchemaHash": {"$ref": "#/$defs/hash"},
    "authorityHash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "gitObject": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}
}
