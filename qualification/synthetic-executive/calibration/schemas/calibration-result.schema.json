{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://katherineseye.com/schemas/synthetic-executive/calibration-result.schema.json",
  "title": "Synthetic Executive Real Route Calibration Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resultType", "status", "authorityHash", "singleUseIdentity", "releaseIdentity", "providerProfileHash", "modelIdentity", "metadataAccess", "credentialBoundary", "requestCounts", "prompt", "usage", "cost", "wallClockDurationMs", "actionBroker", "ledger", "memory", "routeIsolation", "claims", "startedAt", "completedAt", "terminationReason", "resultHash"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "resultType": {"const": "SYNTHETIC_EXECUTIVE_REAL_ROUTE_CALIBRATION_RESULT"},
    "status": {"enum": ["KATHERINE_SYNTHETIC_EXECUTIVE_REAL_ROUTE_CALIBRATED", "REAL_ROUTE_CALIBRATION_PRECHECK_FAILED", "REAL_ROUTE_CALIBRATION_MODEL_ACCESS_FAILED", "REAL_ROUTE_CALIBRATION_PROVIDER_REJECTED", "REAL_ROUTE_CALIBRATION_USAGE_UNAVAILABLE", "REAL_ROUTE_CALIBRATION_ACTION_REJECTED", "REAL_ROUTE_CALIBRATION_SECRET_BOUNDARY_FAILED", "REAL_ROUTE_CALIBRATION_ACCOUNTING_FAILED", "REAL_ROUTE_CALIBRATION_SEAL_FAILED"]},
    "authorityHash": {"$ref": "#/$defs/hash"},
    "singleUseIdentity": {"type": "string"},
    "releaseIdentity": {"type": "object"},
    "providerProfileHash": {"$ref": "#/$defs/hash"},
    "modelIdentity": {"type": "object"},
    "metadataAccess": {"type": ["object", "null"]},
    "credentialBoundary": {"type": "object"},
    "requestCounts": {"type": "object"},
    "prompt": {"type": "object"},
    "usage": {"type": "object"},
    "cost": {"type": "object"},
    "wallClockDurationMs": {"type": "number", "minimum": 0},
    "actionBroker": {"type": "object"},
    "ledger": {"type": "object"},
    "memory": {"type": "object"},
    "routeIsolation": {"type": "object"},
    "claims": {"type": "object"},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "terminationReason": {"type": "string"},
    "resultHash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
