{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://katherineseye.com/schemas/synthetic-executive/authority-sealing-receipt.schema.json",
  "title": "Real Route Calibration Authority Sealing Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptType", "authorityHash", "authorityFileHash", "authoritySchemaHash", "providerProfileHash", "singleUseIdentity", "sealedAt", "receiptHash"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "receiptType": {"const": "REAL_ROUTE_CALIBRATION_AUTHORITY_SEALING_RECEIPT"},
    "authorityHash": {"$ref": "#/$defs/hash"},
    "authorityFileHash": {"$ref": "#/$defs/hash"},
    "authoritySchemaHash": {"$ref": "#/$defs/hash"},
    "providerProfileHash": {"$ref": "#/$defs/hash"},
    "singleUseIdentity": {"type": "string"},
    "sealedAt": {"type": "string", "format": "date-time"},
    "receiptHash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
