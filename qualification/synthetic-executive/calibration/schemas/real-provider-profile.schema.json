{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://katherineseye.com/schemas/synthetic-executive/real-provider-profile.schema.json",
  "title": "Synthetic Executive Real Provider Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileType", "providerIdentity", "endpointClass", "apiBaseUrl", "apiBaseDomainAllowlist", "metadataEndpoint", "inferenceEndpoint", "exactModelId", "reasoning", "responsePersistence", "enabledTools", "disabledTools", "backgroundModeEnabled", "streamingEnabled", "promptCaching", "structuredOutput", "timeoutMs", "ceilings", "pricing", "costCalculation", "usageExtraction", "missingUsageTreatment", "retryPolicy", "credentialBoundary", "redactionRules", "permittedHttpMetadataFields", "forbiddenLoggedFields", "profileHash"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "profileType": {"const": "SYNTHETIC_EXECUTIVE_REAL_PROVIDER_PROFILE"},
    "providerIdentity": {"const": "OPENAI_API"},
    "endpointClass": {"const": "RESPONSES_API"},
    "apiBaseUrl": {"const": "https://api.openai.com"},
    "apiBaseDomainAllowlist": {"const": ["api.openai.com"]},
    "metadataEndpoint": {"const": "v1/models/gpt-5.6-sol"},
    "inferenceEndpoint": {"const": "v1/responses"},
    "exactModelId": {"const": "gpt-5.6-sol"},
    "reasoning": {"type": "object"},
    "responsePersistence": {"type": "object"},
    "enabledTools": {"const": []},
    "disabledTools": {"type": "array", "minItems": 9, "uniqueItems": true},
    "backgroundModeEnabled": {"const": false},
    "streamingEnabled": {"const": false},
    "promptCaching": {"type": "object"},
    "structuredOutput": {"type": "object"},
    "timeoutMs": {"const": 300000},
    "ceilings": {"type": "object"},
    "pricing": {"type": "object"},
    "costCalculation": {"type": "object"},
    "usageExtraction": {"type": "object"},
    "missingUsageTreatment": {"const": "CHARGE_FULL_USD_0_25_RESERVATION_AND_FAIL"},
    "retryPolicy": {"const": "NO_RETRY_AUTHORITY"},
    "credentialBoundary": {"type": "object"},
    "redactionRules": {"type": "array", "minItems": 7, "uniqueItems": true},
    "permittedHttpMetadataFields": {"type": "array", "uniqueItems": true},
    "forbiddenLoggedFields": {"type": "array", "uniqueItems": true},
    "profileHash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
