{
  "name": "katherines-eye",
  "version": "1.12.27",
  "packageManager": "npm@11.16.0",
  "private": true,
  "type": "module",
  "description": "Photo-first buying, selling, and valuation intelligence for Katherine’s Eye.",
  "scripts": {
    "build": "node ./scripts/verify-release-version.mjs",
    "check:version": "node ./scripts/verify-release-version.mjs",
    "check:synthetic-executive-readiness": "node ./qualification/synthetic-executive/scripts/verify-readiness.mjs",
    "prepare:real-route-calibration-release": "node ./qualification/synthetic-executive/calibration/scripts/prepare-real-route-release.mjs",
    "seal:real-route-calibration-release": "node ./qualification/synthetic-executive/calibration/scripts/seal-real-route-release.mjs",
    "authorize:real-route-calibration": "node ./qualification/synthetic-executive/calibration/scripts/run-real-route-calibration.mjs CREATE_AUTHORITY",
    "calibrate:real-route": "node ./qualification/synthetic-executive/calibration/scripts/run-real-route-calibration.mjs RUN_CALIBRATION",
    "qualify:synthetic-executive": "node ./qualification/synthetic-executive/scripts/run-qualification.mjs RUN_FUTURE_AI",
    "start": "powershell -ExecutionPolicy Bypass -File ./server.ps1"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0"
  }
}
