{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "katherines-eye/blind-object-v1/run-journal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","sequence","runId","state","timestamp","requestSha256","responseSha256","detail"],
  "properties": {
    "schemaVersion": {"const":1},
    "sequence": {"type":"integer","minimum":1},
    "runId": {"type":"string","pattern":"^RUN-[0-9]{3}$"},
    "state": {"enum":["PLANNED","PREPARED","STARTED","RESPONSE_RECEIVED","RESPONSE_HASHED","FROZEN","INDETERMINATE"]},
    "timestamp": {"type":"string","format":"date-time"},
    "requestSha256": {"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},
    "responseSha256": {"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},
    "detail": {"type":["string","null"]}
  }
}
