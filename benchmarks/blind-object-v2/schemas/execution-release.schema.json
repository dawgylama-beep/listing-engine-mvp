{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://katherineseye.com/schemas/blind-object-v2/execution-release.schema.json",
  "title": "Synthetic Executive Qualification Readiness Release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "releaseType", "releaseState", "executorRuntimeHead", "executorVersion", "executorRuntimeTreeHash",
    "qualificationPolicyVersion", "requiredQualificationRelationship", "permittedQualificationOverlay", "releasePurpose",
    "aiQualificationPerformed", "productionExecutionAuthorized", "syntheticExecutiveQualified", "cognitionClaimAuthorized", "autonomyClaimAuthorized",
    "readinessManifestHash", "canonicalRoleRegistryHash", "architectureManifestHash", "trustBoundaryDiagramHash",
    "publicEpisodeManifestHash", "evaluatorControlAggregateHash", "budgetProfileHash", "costGovernorProofHash",
    "deterministicHarnessProofHash", "consentExecutionProhibitionHash", "futureQualificationPlanHash",
    "previousExecutionReleaseRecordHash", "immutableProduct", "phase7cFrozenAggregate", "authorityDeclarations", "recordHash"
  ],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "releaseType": { "const": "SYNTHETIC_EXECUTIVE_QUALIFICATION_READINESS_RELEASE" },
    "releaseState": { "enum": ["PENDING_QUALIFICATION_SEAL", "QUALIFIED", "INVALID"] },
    "executorRuntimeHead": { "oneOf": [{ "$ref": "#/$defs/gitObject" }, { "type": "null" }] },
    "executorVersion": { "const": "1.12.25" },
    "executorRuntimeTreeHash": { "oneOf": [{ "$ref": "#/$defs/gitObject" }, { "type": "null" }] },
    "qualificationPolicyVersion": { "const": "1.0" },
    "requiredQualificationRelationship": { "const": "DIRECT_PARENT_ONE_FILE_SEAL" },
    "permittedQualificationOverlay": { "const": ["benchmarks/blind-object-v2/execution-release.json"] },
    "releasePurpose": { "const": "SYNTHETIC_EXECUTIVE_QUALIFICATION_READINESS_ONLY" },
    "aiQualificationPerformed": { "const": false },
    "productionExecutionAuthorized": { "const": false },
    "syntheticExecutiveQualified": { "const": false },
    "cognitionClaimAuthorized": { "const": false },
    "autonomyClaimAuthorized": { "const": false },
    "readinessManifestHash": { "$ref": "#/$defs/hash" },
    "canonicalRoleRegistryHash": { "$ref": "#/$defs/hash" },
    "architectureManifestHash": { "$ref": "#/$defs/hash" },
    "trustBoundaryDiagramHash": { "$ref": "#/$defs/hash" },
    "publicEpisodeManifestHash": { "$ref": "#/$defs/hash" },
    "evaluatorControlAggregateHash": { "$ref": "#/$defs/hash" },
    "budgetProfileHash": { "$ref": "#/$defs/hash" },
    "costGovernorProofHash": { "$ref": "#/$defs/hash" },
    "deterministicHarnessProofHash": { "$ref": "#/$defs/hash" },
    "consentExecutionProhibitionHash": { "$ref": "#/$defs/hash" },
    "futureQualificationPlanHash": { "$ref": "#/$defs/hash" },
    "previousExecutionReleaseRecordHash": { "const": "1de044262cdde4b31a10e23ba5947589c1c76c771eb66f7ea70e9cc27b045bfd" },
    "immutableProduct": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "version", "runtimeManifestHash", "trackedEntryCount"],
      "properties": {
        "commit": { "const": "7056eb0601dc69c5985703fea6fe665e82c6bed8" },
        "version": { "const": "1.12.13" },
        "runtimeManifestHash": { "const": "5a0e3babdfefde7073fddb220f3a9bf0a007c58ecb164418ee3019fb6137a1a8" },
        "trackedEntryCount": { "const": 666 }
      }
    },
    "phase7cFrozenAggregate": { "const": "5eea6b23de0985ffbc9946ac86fbc91c1c2cefd59edbbd5a913080fb77015699" },
    "authorityDeclarations": {
      "type": "object", "additionalProperties": false,
      "required": ["benchmarkConsentCreationEnabled", "benchmarkExecutionEnabled", "modelQualificationEnabled", "providerActivityEnabled", "productHandlerInvocationEnabled", "productionExecutionEnabled", "repairEnabled", "mergeEnabled", "previewDeploymentEnabled", "productionDeploymentEnabled"],
      "properties": {
        "benchmarkConsentCreationEnabled": { "const": false }, "benchmarkExecutionEnabled": { "const": false },
        "modelQualificationEnabled": { "const": false }, "providerActivityEnabled": { "const": false },
        "productHandlerInvocationEnabled": { "const": false }, "productionExecutionEnabled": { "const": false },
        "repairEnabled": { "const": false }, "mergeEnabled": { "const": false },
        "previewDeploymentEnabled": { "const": false }, "productionDeploymentEnabled": { "const": false }
      }
    },
    "recordHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitObject": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
  }
}
