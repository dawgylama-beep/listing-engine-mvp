{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blind-object-v2/continuation-scope.schema.json",
  "title": "Phase 7C Version 1.12.24 cognitive governor continuation scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scopeType", "completeFrozenAggregateHash", "freezeRequestAggregateHash", "historicalExecutionReleaseRecordHash", "predecessorExecutionReleaseRecordHash", "immediatePredecessorExecutionReleaseRecordHash", "currentExecutionReleaseRecordHash", "version1123FailureEvidenceHash", "releaseChainHash", "unusedConsentRevocationReceiptId", "unusedConsentRevocationReceiptHash", "terminalFailureReceiptId", "terminalFailureReceiptHash", "excludedRequests", "orderedRequestIds", "orderedRequestHashInventory", "continuationRequestAggregateHash", "priorPhysicalAttemptCount", "priorConservativeCost", "maximumCumulativePhysicalAttempts", "maximumCumulativeCost", "remainingPhysicalAttemptAuthority", "remainingConservativeCostAuthority", "continuationPhysicalAttemptCeiling", "continuationConservativeMaximumCost", "cumulativeConservativeMaximumCost", "authorizedRequestCount", "continuationScopeHash"],
  "properties": {
    "schemaVersion": { "const": "1.2" },
    "scopeType": { "const": "PHASE_7C_VERSION_1_12_24_COGNITIVE_GOVERNOR_CONTINUATION_SCOPE" },
    "completeFrozenAggregateHash": { "$ref": "#/$defs/hash" },
    "freezeRequestAggregateHash": { "$ref": "#/$defs/hash" },
    "historicalExecutionReleaseRecordHash": { "const": "ed569a1af04bb87e1de1ae4c32eb02719f84bd1b1e861cb55611b28e43ad7013" },
    "predecessorExecutionReleaseRecordHash": { "const": "a80e7e763bb15ff399392be4c3a9cebbd4fb9a7b85622a9c14e4653742473294" },
    "immediatePredecessorExecutionReleaseRecordHash": { "const": "f1074a67e5898493a2c5b4022ae2157635f653fdafe093be64cd4593a7867558" },
    "currentExecutionReleaseRecordHash": { "$ref": "#/$defs/hash" },
    "version1123FailureEvidenceHash": { "const": "22fea392e913b3c028fb4e97bba94249937593db9127b9505e4004c37f6633ff" },
    "releaseChainHash": { "$ref": "#/$defs/hash" },
    "unusedConsentRevocationReceiptId": { "type": "string", "pattern": "^consent-revocation-[a-f0-9]{48}$" },
    "unusedConsentRevocationReceiptHash": { "$ref": "#/$defs/hash" },
    "terminalFailureReceiptId": { "type": "string", "pattern": "^terminal-failure-[a-f0-9]{48}$" },
    "terminalFailureReceiptHash": { "$ref": "#/$defs/hash" },
    "excludedRequests": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["analysisId", "disposition", "replayPermitted"], "properties": { "analysisId": { "enum": ["V2-RUN-001", "V2-RUN-002"] }, "disposition": { "const": "INFRASTRUCTURE_LOST_COGNITIVE_RESULT_NO_REPLAY" }, "replayPermitted": { "const": false } } } },
    "orderedRequestIds": { "type": "array", "minItems": 24, "maxItems": 24, "uniqueItems": true },
    "orderedRequestHashInventory": { "type": "array", "minItems": 24, "maxItems": 24, "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } },
    "continuationRequestAggregateHash": { "$ref": "#/$defs/hash" },
    "priorPhysicalAttemptCount": { "const": 16 },
    "priorConservativeCost": { "const": 3.0136471 },
    "maximumCumulativePhysicalAttempts": { "const": 832 },
    "maximumCumulativeCost": { "const": 40 },
    "remainingPhysicalAttemptAuthority": { "const": 816 },
    "remainingConservativeCostAuthority": { "const": 36.9863529 },
    "continuationPhysicalAttemptCeiling": { "const": 768 },
    "continuationConservativeMaximumCost": { "const": 36.16376522 },
    "cumulativeConservativeMaximumCost": { "const": 39.17741232 },
    "authorizedRequestCount": { "const": 24 },
    "continuationScopeHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
