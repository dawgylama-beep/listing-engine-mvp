{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blind-object-v2/terminal-failure-manifest.schema.json",
  "title": "Sealed pre-external terminal failure manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestType", "failureClassification", "launchScopeHash", "resultId", "resultRootName", "invocationId", "consentHash", "reservationHash", "executionReleaseRecordHash", "executorVersion", "completeFrozenAggregateHash", "requestId", "originalPartialArtifactAggregate", "failureEvidenceAggregate", "zeroExternalSupersessionReceiptId", "zeroExternalSupersessionReceiptHash", "handlerAttemptCount", "providerAttemptCount", "physicalProviderAttemptCount", "actualProviderCost", "requestedCount", "preExternalAbortCount", "notExternallySubmittedCount", "effectiveConsentStatus", "resultRootConsentStatus", "effectiveReservationStatus", "journalEffectiveState", "originalArtifactsByteIdentical", "privateControlsLoaded", "scoringAuthorized", "reflectionAuthorized", "repairAuthorized", "state", "manifestHash"],
  "properties": {
    "schemaVersion": { "const": "1.0" }, "manifestType": { "const": "PRE_EXTERNAL_TERMINAL_FAILURE_MANIFEST" }, "failureClassification": { "const": "ABORTED_PRE_HANDLER_ZERO_EXTERNAL_ACTIVITY" },
    "launchScopeHash": { "$ref": "#/$defs/hash" }, "resultId": { "$ref": "#/$defs/safeId" }, "resultRootName": { "$ref": "#/$defs/safeId" }, "invocationId": { "$ref": "#/$defs/safeId" }, "consentHash": { "$ref": "#/$defs/hash" }, "reservationHash": { "$ref": "#/$defs/hash" }, "executionReleaseRecordHash": { "$ref": "#/$defs/hash" }, "executorVersion": { "type": "string" }, "completeFrozenAggregateHash": { "$ref": "#/$defs/hash" }, "requestId": { "type": "string", "pattern": "^V2-RUN-(?:00[1-9]|01[0-9]|02[0-6])$" },
    "originalPartialArtifactAggregate": { "$ref": "#/$defs/hash" }, "failureEvidenceAggregate": { "$ref": "#/$defs/hash" }, "zeroExternalSupersessionReceiptId": { "oneOf": [{ "type": "string", "pattern": "^supersession-[a-f0-9]{48}$" }, { "type": "null" }] }, "zeroExternalSupersessionReceiptHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "handlerAttemptCount": { "const": 0 }, "providerAttemptCount": { "const": 0 }, "physicalProviderAttemptCount": { "const": 0 }, "actualProviderCost": { "const": 0 }, "requestedCount": { "const": 26 }, "preExternalAbortCount": { "const": 1 }, "notExternallySubmittedCount": { "const": 26 },
    "effectiveConsentStatus": { "const": "CONSUMED" }, "resultRootConsentStatus": { "const": "CONSUMED" }, "effectiveReservationStatus": { "enum": ["CLOSED_ZERO_SPEND", "CLOSED_PRE_EXTERNAL_ABORT"] }, "journalEffectiveState": { "enum": ["PRE_EXTERNAL_ABORT", "LEGACY_SUBMISSION_STARTED_SUPERSEDED_ZERO_EXTERNAL_ACTIVITY"] },
    "originalArtifactsByteIdentical": { "const": true }, "privateControlsLoaded": { "const": false }, "scoringAuthorized": { "const": false }, "reflectionAuthorized": { "const": false }, "repairAuthorized": { "const": false }, "state": { "const": "ABORTED_PRE_HANDLER_ZERO_EXTERNAL_ACTIVITY" }, "manifestHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "safeId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,95}$" } }
}
