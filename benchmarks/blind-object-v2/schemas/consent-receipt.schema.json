{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blind-object-v2/consent-receipt.schema.json",
  "title": "Blind Object Benchmark V2 derived exact-scope execution consent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptType", "launchScopeHash", "consentId", "invocationId", "reservationId", "resultId", "resultRootName", "benchmarkId", "candidateSetId", "productSourceHead", "productSourceVersion", "productRuntimeManifestHash", "executorRuntimeHead", "qualificationHead", "executorRuntimeTreeHash", "executionReleaseRecordHash", "qualificationPolicyVersion", "executorVersion", "completeFrozenAggregateHash", "freezeManifestHash", "freezeReceiptHash", "requestAggregateHash", "orderedRequestHashInventory", "executionProfileIdentityHash", "pricingProfileIdentityHash", "costEnvelopeHash", "completePhysicalAttemptCeiling", "maximumAuthorizedCostMinorUnits", "maximumAuthorizedCost", "conservativeMaximumCostMinorUnits", "conservativeMaximumCost", "fixedResultRoot", "networkPolicyHash", "authorizedRequestCount", "privateControlsAuthorized", "scoringAuthorized", "reflectionAuthorized", "repairAuthorized", "deploymentAuthorized", "status", "statusTransitions", "statusJournalHash", "consentHash", "receiptHash"],
  "properties": {
    "schemaVersion": { "const": "4.0" },
    "receiptType": { "const": "BENCHMARK_EXECUTION_CONSENT" },
    "launchScopeHash": { "$ref": "#/$defs/hash" },
    "consentId": { "$ref": "#/$defs/consentId" },
    "invocationId": { "$ref": "#/$defs/invocationId" },
    "reservationId": { "$ref": "#/$defs/reservationId" },
    "resultId": { "$ref": "#/$defs/resultId" },
    "resultRootName": { "$ref": "#/$defs/resultRootName" },
    "benchmarkId": { "const": "blind-object-v2" },
    "candidateSetId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{7,79}$" },
    "productSourceHead": { "$ref": "#/$defs/commit" },
    "productSourceVersion": { "const": "1.12.13" },
    "productRuntimeManifestHash": { "$ref": "#/$defs/hash" },
    "executorRuntimeHead": { "$ref": "#/$defs/commit" },
    "qualificationHead": { "$ref": "#/$defs/commit" },
    "executorRuntimeTreeHash": { "$ref": "#/$defs/commit" },
    "executionReleaseRecordHash": { "$ref": "#/$defs/hash" },
    "qualificationPolicyVersion": { "const": "1.0" },
    "executorVersion": { "const": "1.12.17" },
    "completeFrozenAggregateHash": { "$ref": "#/$defs/hash" },
    "freezeManifestHash": { "$ref": "#/$defs/hash" },
    "freezeReceiptHash": { "$ref": "#/$defs/hash" },
    "requestAggregateHash": { "$ref": "#/$defs/hash" },
    "orderedRequestHashInventory": { "type": "array", "minItems": 26, "maxItems": 26, "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } },
    "executionProfileIdentityHash": { "$ref": "#/$defs/hash" },
    "pricingProfileIdentityHash": { "$ref": "#/$defs/hash" },
    "costEnvelopeHash": { "$ref": "#/$defs/hash" },
    "completePhysicalAttemptCeiling": { "const": 832 },
    "maximumAuthorizedCostMinorUnits": { "const": 4000 },
    "maximumAuthorizedCost": { "const": 40 },
    "conservativeMaximumCostMinorUnits": { "type": "integer", "minimum": 0, "maximum": 4000 },
    "conservativeMaximumCost": { "type": "number", "minimum": 0, "maximum": 40 },
    "fixedResultRoot": { "type": "string", "pattern": "^benchmarks/blind-object-v2-results/result-root-[a-f0-9]{48}$" },
    "networkPolicyHash": { "$ref": "#/$defs/hash" },
    "authorizedRequestCount": { "const": 26 },
    "privateControlsAuthorized": { "const": false },
    "scoringAuthorized": { "const": false },
    "reflectionAuthorized": { "const": false },
    "repairAuthorized": { "const": false },
    "deploymentAuthorized": { "const": false },
    "status": { "enum": ["AUTHORIZED_NOT_CONSUMED", "CONSUMED", "REVOKED", "INVALID"] },
    "statusTransitions": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "statusJournalHash": { "$ref": "#/$defs/hash" },
    "consentHash": { "$ref": "#/$defs/hash" },
    "receiptHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "consentId": { "type": "string", "pattern": "^consent-[a-f0-9]{48}$" },
    "invocationId": { "type": "string", "pattern": "^invocation-[a-f0-9]{48}$" },
    "reservationId": { "type": "string", "pattern": "^reservation-[a-f0-9]{48}$" },
    "resultId": { "type": "string", "pattern": "^result-[a-f0-9]{48}$" },
    "resultRootName": { "type": "string", "pattern": "^result-root-[a-f0-9]{48}$" }
  }
}
