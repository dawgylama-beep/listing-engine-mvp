{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blind-object-v2/consent-receipt.schema.json",
  "title": "Blind Object Benchmark V2 exact-scope execution consent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptType", "consentId", "invocationId", "resultId", "benchmarkId", "candidateSetId", "productSourceHead", "productSourceVersion", "executorSourceHead", "executorVersion", "completeFrozenAggregateHash", "freezeManifestHash", "freezeReceiptHash", "requestAggregateHash", "orderedRequestHashInventory", "executionProfileHash", "pricingProfileHash", "completePhysicalAttemptCeiling", "maximumAuthorizedCost", "conservativeMaximumCost", "fixedResultRoot", "authorizedNetworkScope", "authorizedRequestCount", "privateControlsAuthorized", "scoringAuthorized", "reflectionAuthorized", "repairAuthorized", "deploymentAuthorized", "status", "statusTransitions", "statusJournalHash", "consentHash", "receiptHash"],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "receiptType": { "const": "BENCHMARK_EXECUTION_CONSENT" },
    "consentId": { "$ref": "#/$defs/id" },
    "invocationId": { "$ref": "#/$defs/id" },
    "resultId": { "$ref": "#/$defs/id" },
    "benchmarkId": { "const": "blind-object-v2" },
    "candidateSetId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{7,79}$" },
    "productSourceHead": { "$ref": "#/$defs/commit" },
    "productSourceVersion": { "const": "1.12.13" },
    "executorSourceHead": { "$ref": "#/$defs/commit" },
    "executorVersion": { "const": "1.12.14" },
    "completeFrozenAggregateHash": { "$ref": "#/$defs/hash" },
    "freezeManifestHash": { "$ref": "#/$defs/hash" },
    "freezeReceiptHash": { "$ref": "#/$defs/hash" },
    "requestAggregateHash": { "$ref": "#/$defs/hash" },
    "orderedRequestHashInventory": { "type": "array", "minItems": 26, "maxItems": 26, "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } },
    "executionProfileHash": { "$ref": "#/$defs/hash" },
    "pricingProfileHash": { "$ref": "#/$defs/hash" },
    "completePhysicalAttemptCeiling": { "const": 832 },
    "maximumAuthorizedCost": { "type": "number", "exclusiveMinimum": 0 },
    "conservativeMaximumCost": { "type": "number", "minimum": 0 },
    "fixedResultRoot": { "type": "string", "pattern": "^benchmarks/blind-object-v2-results/[a-z0-9][a-z0-9-]{7,95}$" },
    "authorizedNetworkScope": { "type": "object" },
    "authorizedRequestCount": { "const": 26 },
    "privateControlsAuthorized": { "const": false },
    "scoringAuthorized": { "const": false },
    "reflectionAuthorized": { "const": false },
    "repairAuthorized": { "const": false },
    "deploymentAuthorized": { "const": false },
    "status": { "enum": ["AUTHORIZED_NOT_CONSUMED", "CONSUMED", "REVOKED", "INVALID"] },
    "statusTransitions": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "statusJournalHash": { "$ref": "#/$defs/hash" },
    "consentHash": { "$ref": "#/$defs/hash" },
    "receiptHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,95}$" }
  }
}
