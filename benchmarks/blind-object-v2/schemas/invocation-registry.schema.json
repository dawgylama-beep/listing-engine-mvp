{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blind-object-v2/invocation-registry.schema.json",
  "title": "Blind Object Benchmark V2 derived exclusive invocation reservation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reservationType", "launchScopeHash", "reservationId", "invocationId", "resultId", "resultRootName", "consentHash", "executionProfileHash", "executionProfileIdentityHash", "pricingProfileHash", "pricingProfileIdentityHash", "costEnvelopeHash", "zeroExternalSupersessionReceiptId", "zeroExternalSupersessionReceiptHash", "completeFrozenAggregateHash", "requestAggregateHash", "productSourceHead", "productSourceVersion", "executorRuntimeHead", "qualificationHead", "executorRuntimeTreeHash", "executionReleaseRecordHash", "qualificationPolicyVersion", "executorVersion", "resultRoot", "createdIdentity", "state", "transitions", "transitionJournalHash", "reservationHash", "recordHash"],
  "properties": {
    "schemaVersion": { "const": "1.1" },
    "reservationType": { "const": "BENCHMARK_INVOCATION_RESERVATION" },
    "launchScopeHash": { "$ref": "#/$defs/hash" },
    "reservationId": { "$ref": "#/$defs/reservationId" },
    "invocationId": { "$ref": "#/$defs/invocationId" },
    "resultId": { "$ref": "#/$defs/resultId" },
    "resultRootName": { "$ref": "#/$defs/resultRootName" },
    "consentHash": { "$ref": "#/$defs/hash" },
    "executionProfileHash": { "$ref": "#/$defs/hash" },
    "executionProfileIdentityHash": { "$ref": "#/$defs/hash" },
    "pricingProfileHash": { "$ref": "#/$defs/hash" },
    "pricingProfileIdentityHash": { "$ref": "#/$defs/hash" },
    "costEnvelopeHash": { "$ref": "#/$defs/hash" },
    "zeroExternalSupersessionReceiptId": { "type": "string", "pattern": "^supersession-[a-f0-9]{48}$" },
    "zeroExternalSupersessionReceiptHash": { "$ref": "#/$defs/hash" },
    "completeFrozenAggregateHash": { "$ref": "#/$defs/hash" },
    "requestAggregateHash": { "$ref": "#/$defs/hash" },
    "productSourceHead": { "$ref": "#/$defs/commit" },
    "productSourceVersion": { "const": "1.12.13" },
    "executorRuntimeHead": { "$ref": "#/$defs/commit" },
    "qualificationHead": { "$ref": "#/$defs/commit" },
    "executorRuntimeTreeHash": { "$ref": "#/$defs/commit" },
    "executionReleaseRecordHash": { "$ref": "#/$defs/hash" },
    "qualificationPolicyVersion": { "const": "1.0" },
    "executorVersion": { "const": "1.12.21" },
    "resultRoot": { "type": "string", "pattern": "^benchmarks/blind-object-v2-results/result-root-[a-f0-9]{48}$" },
    "createdIdentity": { "type": "string", "minLength": 8, "maxLength": 120 },
    "state": { "enum": ["RESERVED_NOT_STARTED", "STARTED", "INDETERMINATE", "CONSUMED", "FAILED_BEFORE_START", "CLOSED_PRE_EXTERNAL_ABORT", "INVALID"] },
    "transitions": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "transitionJournalHash": { "$ref": "#/$defs/hash" },
    "reservationHash": { "$ref": "#/$defs/hash" },
    "recordHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "reservationId": { "type": "string", "pattern": "^reservation-[a-f0-9]{48}$" },
    "invocationId": { "type": "string", "pattern": "^invocation-[a-f0-9]{48}$" },
    "resultId": { "type": "string", "pattern": "^result-[a-f0-9]{48}$" },
    "resultRootName": { "type": "string", "pattern": "^result-root-[a-f0-9]{48}$" }
  }
}
