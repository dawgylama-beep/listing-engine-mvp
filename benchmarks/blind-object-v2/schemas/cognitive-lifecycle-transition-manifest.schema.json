{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blind-object-v2/cognitive-lifecycle-transition-manifest.schema.json",
  "title": "Cognitive lifecycle governor transition manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestType", "governorVersion", "releaseRecordHash", "consentId", "invocationId", "reservationId", "resultId", "resultRootName", "orderedRequestIds", "nodes", "transitionRecords", "stoppedTerminalNode", "invariantCatalogHash", "manifestHash"],
  "properties": {
    "schemaVersion": { "const": "1.0" }, "manifestType": { "const": "COGNITIVE_LIFECYCLE_TRANSITION_MANIFEST" }, "governorVersion": { "const": "1.0" },
    "releaseRecordHash": { "$ref": "#/$defs/hash" }, "consentId": { "type": "string" }, "invocationId": { "type": "string" }, "reservationId": { "type": "string" }, "resultId": { "type": "string" }, "resultRootName": { "type": "string" },
    "orderedRequestIds": { "type": "array", "minItems": 1, "maxItems": 26, "uniqueItems": true, "items": { "type": "string", "pattern": "^V2-RUN-(?:00[1-9]|01[0-9]|02[0-6])$" } },
    "nodes": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/node" } },
    "transitionRecords": { "type": "array", "minItems": 6, "items": { "type": "object", "additionalProperties": false, "required": ["fromNodeId", "toNodeId", "guard", "stoppedSuccessorNodeId"], "properties": { "fromNodeId": { "type": "string" }, "toNodeId": { "type": "string" }, "guard": { "const": "OBSERVED_EVIDENCE_SATISFIES_PHASE_INVARIANT" }, "stoppedSuccessorNodeId": { "const": "terminal:STOPPED_NOVEL_CONDITION" } } } },
    "stoppedTerminalNode": { "type": "object", "additionalProperties": false, "required": ["nodeId", "phase", "terminal", "successorNodeId"], "properties": { "nodeId": { "const": "terminal:STOPPED_NOVEL_CONDITION" }, "phase": { "const": "STOPPED_NOVEL_CONDITION" }, "terminal": { "const": true }, "successorNodeId": { "type": "null" } } },
    "invariantCatalogHash": { "$ref": "#/$defs/hash" }, "manifestHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "node": { "type": "object", "additionalProperties": false, "required": ["nodeId", "phase", "requestId", "ordinal", "successorNodeId", "terminal"], "properties": { "nodeId": { "type": "string" }, "phase": { "enum": ["RELEASE_VERIFIED", "PREFLIGHT_PASSED", "CONSENT_AUTHORIZED", "RESERVATION_CREATED", "HANDLER_STARTED", "HANDLER_RETURNED_QUARANTINED", "SANITIZATION_DECIDED", "TERMINAL_PERSISTED", "READBACK_VERIFIED", "COMPOSITE_SEALED", "COGNITIVE_EVALUATION_READY"] }, "requestId": { "oneOf": [{ "type": "string" }, { "type": "null" }] }, "ordinal": { "type": "integer", "minimum": 1 }, "successorNodeId": { "oneOf": [{ "type": "string" }, { "type": "null" }] }, "terminal": { "type": "boolean" } } }
  }
}
