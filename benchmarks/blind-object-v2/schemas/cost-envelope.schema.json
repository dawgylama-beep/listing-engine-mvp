{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blind-object-v2/cost-envelope.schema.json",
  "title": "Blind Object Benchmark V2 source-grounded complete-run cost envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "envelopeType", "productSourceSha256", "sourceBindingAggregateHash", "sourceBindings", "frozenRequestByteBounds", "frozenRequestByteBoundAggregateHash", "pricingProfileIdentityHash", "executionProfileIdentityHash", "completeAttemptCeilingHash", "completePhysicalAttemptCeiling", "modelProvider", "exactModelLiteral", "acquisitionProviderMode", "outputCeilings", "imageAccounting", "webSearchAccounting", "carryForwardAccounting", "includedAttemptBoundaries", "billableCategories", "uncertaintyMargin", "currency", "subtotalBeforeMargin", "conservativeMaximumCost", "conservativeMaximumCostMinorUnits", "authorizedMaximumMinorUnits", "costState", "costEnvelopeHash"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "envelopeType": { "const": "BLIND_OBJECT_V2_SOURCE_GROUNDED_COST_ENVELOPE" },
    "productSourceSha256": { "$ref": "#/$defs/hash" },
    "sourceBindingAggregateHash": { "$ref": "#/$defs/hash" },
    "sourceBindings": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "type": "object" } },
    "frozenRequestByteBounds": { "type": "array", "minItems": 26, "maxItems": 26, "items": { "type": "object" } },
    "frozenRequestByteBoundAggregateHash": { "$ref": "#/$defs/hash" },
    "pricingProfileIdentityHash": { "$ref": "#/$defs/hash" },
    "executionProfileIdentityHash": { "$ref": "#/$defs/hash" },
    "completeAttemptCeilingHash": { "$ref": "#/$defs/hash" },
    "completePhysicalAttemptCeiling": { "const": 832 },
    "modelProvider": { "const": "OPENAI" },
    "exactModelLiteral": { "const": "gpt-4.1-mini" },
    "acquisitionProviderMode": { "enum": ["OPENAI_WEB_SEARCH_ONLY", "SERPER_WITH_OPENAI_WEB_SEARCH_FALLBACK"] },
    "outputCeilings": { "type": "object" },
    "imageAccounting": { "type": "object" },
    "webSearchAccounting": { "type": "object" },
    "carryForwardAccounting": { "type": "object" },
    "includedAttemptBoundaries": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "object" } },
    "billableCategories": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "object" } },
    "uncertaintyMargin": { "type": "number", "minimum": 0.2 },
    "currency": { "const": "USD" },
    "subtotalBeforeMargin": { "type": "number", "minimum": 0 },
    "conservativeMaximumCost": { "type": "number", "minimum": 0 },
    "conservativeMaximumCostMinorUnits": { "type": "integer", "minimum": 0 },
    "authorizedMaximumMinorUnits": { "const": 4000 },
    "costState": { "enum": ["COMPLETE_RUN_WITHIN_AUTHORIZED_COST", "COMPLETE_RUN_EXCEEDS_AUTHORIZED_COST", "COST_ENVELOPE_INCOMPLETE", "COST_ENVELOPE_INVALID"] },
    "costEnvelopeHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
