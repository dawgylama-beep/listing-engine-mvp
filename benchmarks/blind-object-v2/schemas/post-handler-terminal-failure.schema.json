{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blind-object-v2/post-handler-terminal-failure.schema.json",
  "title": "Blind Object V2 post-handler terminal failure",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestType", "launchScopeHash", "continuationScopeHash", "resultId", "resultRootName", "invocationId", "consentHash", "reservationHash", "executionReleaseRecordHash", "executorVersion", "completeFrozenAggregateHash", "requestId", "handlerReturnedReceiptId", "handlerReturnedReceiptHash", "canonicalHandlerResultHash", "handlerOutcome", "handlerInvocationCount", "providerAttemptCount", "physicalProviderAttemptCount", "conservativeConsumedCost", "actualBilledCostStatus", "publicResponseArtifactCommitted", "replayPermitted", "failureStage", "failureCategory", "failureEvidenceAggregate", "effectiveConsentStatus", "effectiveInvocationStatus", "effectiveReservationStatus", "journalEffectiveState", "privateControlsLoaded", "scoringAuthorized", "reflectionAuthorized", "repairAuthorized", "state", "manifestHash"],
  "properties": {
    "schemaVersion": { "const": "1.0" }, "manifestType": { "const": "POST_HANDLER_TERMINAL_FAILURE_MANIFEST" }, "launchScopeHash": { "$ref": "#/$defs/hash" }, "continuationScopeHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }, "resultId": { "type": "string" }, "resultRootName": { "type": "string" }, "invocationId": { "type": "string" }, "consentHash": { "$ref": "#/$defs/hash" }, "reservationHash": { "$ref": "#/$defs/hash" }, "executionReleaseRecordHash": { "$ref": "#/$defs/hash" }, "executorVersion": { "type": "string" }, "completeFrozenAggregateHash": { "$ref": "#/$defs/hash" }, "requestId": { "type": "string" }, "handlerReturnedReceiptId": { "type": "string" }, "handlerReturnedReceiptHash": { "$ref": "#/$defs/hash" }, "canonicalHandlerResultHash": { "$ref": "#/$defs/hash" }, "handlerOutcome": { "enum": ["NORMAL_SUCCESS", "PRODUCT_TERMINAL_FAILURE"] }, "handlerInvocationCount": { "const": 1 }, "providerAttemptCount": { "type": "integer", "minimum": 0 }, "physicalProviderAttemptCount": { "type": "integer", "minimum": 0 }, "conservativeConsumedCost": { "type": "number", "minimum": 0 }, "actualBilledCostStatus": { "const": "UNKNOWN" }, "publicResponseArtifactCommitted": { "const": false }, "replayPermitted": { "const": false }, "failureStage": { "const": "POST_HANDLER_TERMINAL_RECORD_SANITIZATION" }, "failureCategory": { "const": "SECRET_SANITIZER_REJECTED_TERMINAL_RECORD" }, "failureEvidenceAggregate": { "$ref": "#/$defs/hash" }, "effectiveConsentStatus": { "const": "CONSUMED" }, "effectiveInvocationStatus": { "const": "TERMINAL_FAILED" }, "effectiveReservationStatus": { "const": "CLOSED_CONSERVATIVE_COST_ACCOUNTED" }, "journalEffectiveState": { "const": "POST_HANDLER_SANITIZATION_FAILED" }, "privateControlsLoaded": { "const": false }, "scoringAuthorized": { "const": false }, "reflectionAuthorized": { "const": false }, "repairAuthorized": { "const": false }, "state": { "const": "ABORTED_POST_HANDLER_SANITIZATION_RESPONSE_NOT_PERSISTED" }, "manifestHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
