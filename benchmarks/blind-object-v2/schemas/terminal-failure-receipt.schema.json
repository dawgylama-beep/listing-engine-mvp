{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blind-object-v2/terminal-failure-receipt.schema.json",
  "title": "Version 1.12.21 terminal failure receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptType", "receiptId", "failureAuthorityHash", "sourceExecutionReleaseRecordHash", "sourceExecutorVersion", "sourceResultRootName", "sourcePartialArtifactAggregate", "sourceJournalHash", "sourceLedgerHash", "sourceConsentId", "sourceConsentHash", "sourceInvocationId", "sourceReservationId", "sourceReservationHash", "sourceResultId", "sourceRequestId", "sourceSubmissionIdentity", "handlerOutcome", "handlerInvocationCount", "providerAttemptCount", "physicalProviderAttemptCount", "providerReportedUsageRecordCount", "actualBilledCostStatus", "conservativeAccountedCost", "handlerResultBytesStatus", "publicResponseArtifactStatus", "successfulManifestStatus", "terminalState", "replayPermitted", "effectiveConsentStatus", "effectiveInvocationStatus", "effectiveReservationStatus", "successorExecutionReleaseRecordHash", "successorExecutorRuntimeHead", "successorQualificationHead", "successorExecutorVersion", "createdAt", "receiptHash"],
  "properties": {
    "schemaVersion": { "const": "1.0" }, "receiptType": { "const": "VERSION_1_12_21_TERMINAL_FAILURE_RECEIPT" }, "receiptId": { "type": "string", "pattern": "^terminal-failure-[a-f0-9]{48}$" },
    "failureAuthorityHash": { "$ref": "#/$defs/hash" }, "sourceExecutionReleaseRecordHash": { "$ref": "#/$defs/hash" }, "sourceExecutorVersion": { "const": "1.12.21" }, "sourceResultRootName": { "$ref": "#/$defs/id" }, "sourcePartialArtifactAggregate": { "$ref": "#/$defs/hash" }, "sourceJournalHash": { "$ref": "#/$defs/hash" }, "sourceLedgerHash": { "$ref": "#/$defs/hash" }, "sourceConsentId": { "$ref": "#/$defs/id" }, "sourceConsentHash": { "$ref": "#/$defs/hash" }, "sourceInvocationId": { "$ref": "#/$defs/id" }, "sourceReservationId": { "$ref": "#/$defs/id" }, "sourceReservationHash": { "$ref": "#/$defs/hash" }, "sourceResultId": { "$ref": "#/$defs/id" }, "sourceRequestId": { "const": "V2-RUN-001" }, "sourceSubmissionIdentity": { "type": "string", "pattern": "^submission-[a-f0-9]{32}$" },
    "handlerOutcome": { "const": "NORMAL_SUCCESS" }, "handlerInvocationCount": { "const": 1 }, "providerAttemptCount": { "const": 9 }, "physicalProviderAttemptCount": { "const": 9 }, "providerReportedUsageRecordCount": { "const": 0 }, "actualBilledCostStatus": { "const": "UNKNOWN" }, "conservativeAccountedCost": { "const": 1.50682355 }, "handlerResultBytesStatus": { "const": "NOT_DURABLY_CAPTURED" }, "publicResponseArtifactStatus": { "const": "ABSENT" }, "successfulManifestStatus": { "const": "ABSENT" }, "terminalState": { "const": "ABORTED_POST_HANDLER_SANITIZATION_RESPONSE_NOT_PERSISTED" }, "replayPermitted": { "const": false }, "effectiveConsentStatus": { "const": "CONSUMED" }, "effectiveInvocationStatus": { "const": "TERMINAL_FAILED" }, "effectiveReservationStatus": { "const": "CLOSED_CONSERVATIVE_COST_ACCOUNTED" },
    "successorExecutionReleaseRecordHash": { "$ref": "#/$defs/hash" }, "successorExecutorRuntimeHead": { "$ref": "#/$defs/commit" }, "successorQualificationHead": { "$ref": "#/$defs/commit" }, "successorExecutorVersion": { "const": "1.12.22" }, "createdAt": { "type": "string", "format": "date-time" }, "receiptHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,95}$" } }
}
