{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blind-object-v2/composite-unscored-evidence-manifest.schema.json",
  "title": "Phase 7C count-bearing unscored composite evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestType", "compositeId", "benchmarkId", "completeFrozenAggregateHash", "freezeRequestAggregateHash", "totalFrozenRequestCount", "version1121TerminalFailureReceiptId", "version1121TerminalFailureReceiptHash", "version1121TerminalFailureTreeAggregate", "version1123FailureEvidenceHash", "version1124ExecutionReleaseRecordHash", "version1124LaunchScopeHash", "version1124ContinuationScopeHash", "version1124ConsentHash", "version1124InvocationId", "version1124ResultId", "version1124ResultRootName", "version1124ManifestHash", "version1124ResultTreeAggregate", "lifecycleTransitionManifestHash", "lifecycleInvariantCatalogHash", "governorDecisionAggregateHash", "orderedRequestDispositions", "cognitiveResultCount", "infrastructureFailureCount", "notSubmittedCount", "handlerInvocationCount", "providerAttemptCount", "physicalProviderAttemptCount", "providerReportedUsageRecordCount", "actualBilledCostStatus", "knownActualCost", "conservativeAccountedCost", "remainingPhysicalAttemptBalance", "remainingConservativeCostBalance", "maximumCumulativePhysicalAttempts", "maximumCumulativeCost", "evaluatorOnlyOriginalsLoaded", "privateControlsLoaded", "scoringPerformed", "reflectionPerformed", "diagnosisPerformed", "lessonPromotionPerformed", "state", "manifestHash"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "manifestType": { "const": "PHASE_7C_COUNT_BEARING_UNSCORED_COMPOSITE_EVIDENCE_MANIFEST" },
    "compositeId": { "type": "string", "pattern": "^composite-[a-f0-9]{48}$" },
    "benchmarkId": { "const": "blind-object-v2" },
    "completeFrozenAggregateHash": { "$ref": "#/$defs/hash" }, "freezeRequestAggregateHash": { "$ref": "#/$defs/hash" }, "totalFrozenRequestCount": { "const": 26 },
    "version1121TerminalFailureReceiptId": { "type": "string" }, "version1121TerminalFailureReceiptHash": { "$ref": "#/$defs/hash" }, "version1121TerminalFailureTreeAggregate": { "$ref": "#/$defs/hash" },
    "version1123FailureEvidenceHash": { "$ref": "#/$defs/hash" }, "version1124ExecutionReleaseRecordHash": { "$ref": "#/$defs/hash" }, "version1124LaunchScopeHash": { "$ref": "#/$defs/hash" }, "version1124ContinuationScopeHash": { "$ref": "#/$defs/hash" }, "version1124ConsentHash": { "$ref": "#/$defs/hash" }, "version1124InvocationId": { "type": "string" }, "version1124ResultId": { "type": "string" }, "version1124ResultRootName": { "type": "string" }, "version1124ManifestHash": { "$ref": "#/$defs/hash" }, "version1124ResultTreeAggregate": { "$ref": "#/$defs/hash" },
    "lifecycleTransitionManifestHash": { "$ref": "#/$defs/hash" }, "lifecycleInvariantCatalogHash": { "$ref": "#/$defs/hash" }, "governorDecisionAggregateHash": { "$ref": "#/$defs/hash" },
    "orderedRequestDispositions": { "type": "array", "minItems": 26, "maxItems": 26, "items": { "type": "object", "additionalProperties": false, "required": ["analysisId", "disposition", "cognitiveResultAvailable", "replayPermitted", "sourceVersion", "terminalEvidenceHash", "terminalResultRecordHash"], "properties": { "analysisId": { "type": "string" }, "disposition": { "enum": ["INFRASTRUCTURE_LOST_COGNITIVE_RESULT_NO_REPLAY", "COGNITIVE_RESULT_AVAILABLE_UNSCORED"] }, "cognitiveResultAvailable": { "type": "boolean" }, "replayPermitted": { "const": false }, "sourceVersion": { "enum": ["1.12.21", "1.12.23", "1.12.24"] }, "terminalEvidenceHash": { "$ref": "#/$defs/hash" }, "terminalResultRecordHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] } } } },
    "cognitiveResultCount": { "const": 24 }, "infrastructureFailureCount": { "const": 2 }, "notSubmittedCount": { "const": 0 }, "handlerInvocationCount": { "const": 26 },
    "providerAttemptCount": { "type": "integer", "minimum": 0 }, "physicalProviderAttemptCount": { "type": "integer", "minimum": 0, "maximum": 832 }, "providerReportedUsageRecordCount": { "type": "integer", "minimum": 0 }, "actualBilledCostStatus": { "const": "UNKNOWN" }, "knownActualCost": { "type": "null" }, "conservativeAccountedCost": { "type": "number", "minimum": 0, "maximum": 40 }, "remainingPhysicalAttemptBalance": { "type": "integer", "minimum": 0 }, "remainingConservativeCostBalance": { "type": "number", "minimum": 0 }, "maximumCumulativePhysicalAttempts": { "const": 832 }, "maximumCumulativeCost": { "const": 40 },
    "evaluatorOnlyOriginalsLoaded": { "const": false }, "privateControlsLoaded": { "const": false }, "scoringPerformed": { "const": false }, "reflectionPerformed": { "const": false }, "diagnosisPerformed": { "const": false }, "lessonPromotionPerformed": { "const": false },
    "state": { "const": "COMPLETE_WITH_24_COGNITIVE_RESULTS_AND_2_INFRASTRUCTURE_FAILURES" }, "manifestHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
