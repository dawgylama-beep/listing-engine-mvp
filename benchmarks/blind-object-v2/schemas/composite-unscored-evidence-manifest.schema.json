{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blind-object-v2/composite-unscored-evidence-manifest.schema.json",
  "title": "Phase 7C unscored composite evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestType", "compositeId", "benchmarkId", "completeFrozenAggregateHash", "freezeRequestAggregateHash", "version1121TerminalFailureReceiptId", "version1121TerminalFailureReceiptHash", "version1121TerminalFailureTreeAggregate", "version1121ResultRootName", "version1122ExecutionReleaseRecordHash", "version1122LaunchScopeHash", "version1122ContinuationScopeHash", "version1122ConsentHash", "version1122InvocationId", "version1122ResultId", "version1122ResultRootName", "version1122ManifestHash", "version1122ResultTreeAggregate", "orderedRequestDispositions", "cognitiveResultCount", "infrastructureFailureCount", "handlerInvocationCount", "providerAttemptCount", "physicalProviderAttemptCount", "providerReportedUsageRecordCount", "actualBilledCostStatus", "knownActualCost", "conservativeAccountedCost", "maximumCumulativePhysicalAttempts", "maximumCumulativeCost", "evaluatorOnlyOriginalsLoaded", "privateControlsLoaded", "scoringPerformed", "reflectionPerformed", "diagnosisPerformed", "lessonPromotionPerformed", "state", "manifestHash"],
  "properties": {
    "schemaVersion": { "const": "1.0" }, "manifestType": { "const": "PHASE_7C_UNSCORED_COMPOSITE_EVIDENCE_MANIFEST" }, "compositeId": { "type": "string", "pattern": "^composite-[a-f0-9]{48}$" }, "benchmarkId": { "const": "blind-object-v2" },
    "completeFrozenAggregateHash": { "$ref": "#/$defs/hash" }, "freezeRequestAggregateHash": { "$ref": "#/$defs/hash" }, "version1121TerminalFailureReceiptId": { "type": "string", "pattern": "^terminal-failure-[a-f0-9]{48}$" }, "version1121TerminalFailureReceiptHash": { "$ref": "#/$defs/hash" }, "version1121TerminalFailureTreeAggregate": { "$ref": "#/$defs/hash" }, "version1121ResultRootName": { "$ref": "#/$defs/id" }, "version1122ExecutionReleaseRecordHash": { "$ref": "#/$defs/hash" }, "version1122LaunchScopeHash": { "$ref": "#/$defs/hash" }, "version1122ContinuationScopeHash": { "$ref": "#/$defs/hash" }, "version1122ConsentHash": { "$ref": "#/$defs/hash" }, "version1122InvocationId": { "$ref": "#/$defs/id" }, "version1122ResultId": { "$ref": "#/$defs/id" }, "version1122ResultRootName": { "$ref": "#/$defs/id" }, "version1122ManifestHash": { "$ref": "#/$defs/hash" }, "version1122ResultTreeAggregate": { "$ref": "#/$defs/hash" },
    "orderedRequestDispositions": { "type": "array", "minItems": 26, "maxItems": 26, "items": { "type": "object", "additionalProperties": false, "required": ["analysisId", "disposition", "cognitiveResultAvailable", "replayPermitted", "sourceVersion", "terminalEvidenceHash", "terminalResultRecordHash"], "properties": { "analysisId": { "type": "string", "pattern": "^V2-RUN-(?:00[1-9]|01[0-9]|02[0-6])$" }, "disposition": { "enum": ["INFRASTRUCTURE_LOST_COGNITIVE_RESULT_NO_REPLAY", "COGNITIVE_RESULT_AVAILABLE_UNSCORED"] }, "cognitiveResultAvailable": { "type": "boolean" }, "replayPermitted": { "const": false }, "sourceVersion": { "enum": ["1.12.21", "1.12.23"] }, "terminalEvidenceHash": { "$ref": "#/$defs/hash" }, "terminalResultRecordHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] } } } },
    "cognitiveResultCount": { "const": 25 }, "infrastructureFailureCount": { "const": 1 }, "handlerInvocationCount": { "const": 26 }, "providerAttemptCount": { "type": "integer", "minimum": 0 }, "physicalProviderAttemptCount": { "type": "integer", "minimum": 0, "maximum": 832 }, "providerReportedUsageRecordCount": { "type": "integer", "minimum": 0 }, "actualBilledCostStatus": { "const": "UNKNOWN" }, "knownActualCost": { "type": "null" }, "conservativeAccountedCost": { "type": "number", "minimum": 0, "maximum": 40 }, "maximumCumulativePhysicalAttempts": { "const": 832 }, "maximumCumulativeCost": { "const": 40 }, "evaluatorOnlyOriginalsLoaded": { "const": false }, "privateControlsLoaded": { "const": false }, "scoringPerformed": { "const": false }, "reflectionPerformed": { "const": false }, "diagnosisPerformed": { "const": false }, "lessonPromotionPerformed": { "const": false }, "state": { "const": "COMPLETE_WITH_25_COGNITIVE_RESULTS_AND_1_INFRASTRUCTURE_FAILURE" }, "manifestHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,95}$" } }
}
