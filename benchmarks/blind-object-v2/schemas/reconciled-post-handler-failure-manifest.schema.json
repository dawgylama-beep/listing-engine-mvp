{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blind-object-v2/reconciled-post-handler-failure-manifest.schema.json",
  "title": "Reconciled Version 1.12.21 post-handler failure manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestType", "terminalFailureReceiptId", "terminalFailureReceiptHash", "reservationClosureId", "reservationClosureHash", "sourceExecutionReleaseRecordHash", "sourceExecutorVersion", "sourceResultRootName", "sourcePartialArtifactAggregate", "sourceJournalHash", "sourceLedgerHash", "sourceConsentHash", "sourceInvocationId", "sourceReservationHash", "sourceResultId", "sourceRequestId", "handlerOutcome", "handlerInvocationCount", "providerAttemptCount", "physicalProviderAttemptCount", "providerReportedUsageRecordCount", "conservativeAccountedCost", "actualBilledCostStatus", "publicResponseArtifactCommitted", "successfulManifestPresent", "replayPermitted", "failureEvidenceAggregate", "originalArtifactsByteIdentical", "effectiveConsentStatus", "effectiveInvocationStatus", "effectiveReservationStatus", "privateControlsLoaded", "scoringAuthorized", "reflectionAuthorized", "repairAuthorized", "state", "manifestHash"],
  "properties": {
    "schemaVersion": { "const": "1.0" }, "manifestType": { "const": "RECONCILED_POST_HANDLER_TERMINAL_FAILURE_MANIFEST" }, "terminalFailureReceiptId": { "type": "string", "pattern": "^terminal-failure-[a-f0-9]{48}$" }, "terminalFailureReceiptHash": { "$ref": "#/$defs/hash" }, "reservationClosureId": { "type": "string", "pattern": "^reservation-closure-[a-f0-9]{48}$" }, "reservationClosureHash": { "$ref": "#/$defs/hash" },
    "sourceExecutionReleaseRecordHash": { "$ref": "#/$defs/hash" }, "sourceExecutorVersion": { "const": "1.12.21" }, "sourceResultRootName": { "$ref": "#/$defs/id" }, "sourcePartialArtifactAggregate": { "$ref": "#/$defs/hash" }, "sourceJournalHash": { "$ref": "#/$defs/hash" }, "sourceLedgerHash": { "$ref": "#/$defs/hash" }, "sourceConsentHash": { "$ref": "#/$defs/hash" }, "sourceInvocationId": { "$ref": "#/$defs/id" }, "sourceReservationHash": { "$ref": "#/$defs/hash" }, "sourceResultId": { "$ref": "#/$defs/id" }, "sourceRequestId": { "const": "V2-RUN-001" }, "handlerOutcome": { "const": "NORMAL_SUCCESS" },
    "handlerInvocationCount": { "const": 1 }, "providerAttemptCount": { "const": 9 }, "physicalProviderAttemptCount": { "const": 9 }, "providerReportedUsageRecordCount": { "const": 0 }, "conservativeAccountedCost": { "const": 1.50682355 }, "actualBilledCostStatus": { "const": "UNKNOWN" }, "publicResponseArtifactCommitted": { "const": false }, "successfulManifestPresent": { "const": false }, "replayPermitted": { "const": false }, "failureEvidenceAggregate": { "$ref": "#/$defs/hash" }, "originalArtifactsByteIdentical": { "const": true }, "effectiveConsentStatus": { "const": "CONSUMED" }, "effectiveInvocationStatus": { "const": "TERMINAL_FAILED" }, "effectiveReservationStatus": { "const": "CLOSED_CONSERVATIVE_COST_ACCOUNTED" }, "privateControlsLoaded": { "const": false }, "scoringAuthorized": { "const": false }, "reflectionAuthorized": { "const": false }, "repairAuthorized": { "const": false }, "state": { "const": "ABORTED_POST_HANDLER_SANITIZATION_RESPONSE_NOT_PERSISTED" }, "manifestHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,95}$" } }
