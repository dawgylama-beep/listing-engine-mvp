{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blind-object-v2/frozen-package.schema.json",
  "title": "Blind Object Benchmark V2 complete release-bound freeze manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "benchmarkId", "state", "candidateSetId", "canonicalObjectIdNamespace", "sourceRepositoryHead",
    "sourceVersion", "sourcePackageSha256", "sourcePackageBytes", "packageManifestFileHash", "checksumFileHash",
    "sanitizedInputAggregateHash", "sourceOriginalAggregateHash", "publicIntakeManifestHash", "privateControlAggregateHash",
    "provenanceAggregateHash", "analysisPlanHash", "requestAggregateHash", "specificationHash", "coverageHash", "scoringHash",
    "objectCount", "sanitizedPhotoCount", "sourceOriginalCount", "requestCount", "anchorObjectCount", "laneCounts",
    "primaryPurposeCounts", "analysisPurposeCounts", "frozenArtifactRoot", "completeFrozenAggregateHash", "absentAuthority",
    "requestContractHashes", "sourceCommit", "version", "inputManifestHash", "coverageContractHash", "scoringContractHash",
    "frozenInputAggregateHash", "freezeAggregateHash", "executionAuthorized", "consentReceiptHash", "networkRequestCount",
    "providerCallCount", "frozenRequestExecutionCount", "freezeManifestHash"
  ],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "benchmarkId": { "const": "blind-object-v2" },
    "state": { "const": "FROZEN_AWAITING_CONSENT" },
    "candidateSetId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{7,79}$" },
    "canonicalObjectIdNamespace": { "const": "V2-OBJ-001_THROUGH_V2-OBJ-014" },
    "sourceRepositoryHead": { "$ref": "#/$defs/commit" },
    "sourceVersion": { "$ref": "#/$defs/version" },
    "sourcePackageSha256": { "$ref": "#/$defs/hash" },
    "sourcePackageBytes": { "type": "integer", "minimum": 1 },
    "packageManifestFileHash": { "$ref": "#/$defs/hash" },
    "checksumFileHash": { "$ref": "#/$defs/hash" },
    "sanitizedInputAggregateHash": { "$ref": "#/$defs/hash" },
    "sourceOriginalAggregateHash": { "$ref": "#/$defs/hash" },
    "publicIntakeManifestHash": { "$ref": "#/$defs/hash" },
    "privateControlAggregateHash": { "$ref": "#/$defs/hash" },
    "provenanceAggregateHash": { "$ref": "#/$defs/hash" },
    "analysisPlanHash": { "$ref": "#/$defs/hash" },
    "requestAggregateHash": { "$ref": "#/$defs/hash" },
    "specificationHash": { "$ref": "#/$defs/hash" },
    "coverageHash": { "$ref": "#/$defs/hash" },
    "scoringHash": { "$ref": "#/$defs/hash" },
    "objectCount": { "const": 14 },
    "sanitizedPhotoCount": { "type": "integer", "minimum": 28, "maximum": 56 },
    "sourceOriginalCount": { "type": "integer", "minimum": 28, "maximum": 56 },
    "requestCount": { "const": 26 },
    "anchorObjectCount": { "const": 4 },
    "laneCounts": { "$ref": "#/$defs/laneCounts" },
    "primaryPurposeCounts": { "$ref": "#/$defs/primaryPurposeCounts" },
    "analysisPurposeCounts": { "$ref": "#/$defs/analysisPurposeCounts" },
    "frozenArtifactRoot": { "type": "string", "pattern": "^benchmarks/blind-object-v2/prepared/freezes/[a-f0-9]{64}$" },
    "completeFrozenAggregateHash": { "$ref": "#/$defs/hash" },
    "absentAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionConsent", "invocationReservation", "providerSelection", "modelSelection", "costAuthorization", "networkAuthorization", "executionJournal", "benchmarkResponses", "scores", "productRepairAuthorization", "deploymentAuthorization"],
      "properties": {
        "executionConsent": { "const": false }, "invocationReservation": { "const": false }, "providerSelection": { "const": false },
        "modelSelection": { "const": false }, "costAuthorization": { "const": false }, "networkAuthorization": { "const": false },
        "executionJournal": { "const": false }, "benchmarkResponses": { "const": false }, "scores": { "const": false },
        "productRepairAuthorization": { "const": false }, "deploymentAuthorization": { "const": false }
      }
    },
    "requestContractHashes": { "type": "array", "minItems": 26, "maxItems": 26, "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } },
    "sourceCommit": { "$ref": "#/$defs/commit" },
    "version": { "$ref": "#/$defs/version" },
    "inputManifestHash": { "$ref": "#/$defs/hash" },
    "coverageContractHash": { "$ref": "#/$defs/hash" },
    "scoringContractHash": { "$ref": "#/$defs/hash" },
    "frozenInputAggregateHash": { "$ref": "#/$defs/hash" },
    "freezeAggregateHash": { "$ref": "#/$defs/hash" },
    "executionAuthorized": { "const": false },
    "consentReceiptHash": { "type": "null" },
    "networkRequestCount": { "const": 0 },
    "providerCallCount": { "const": 0 },
    "frozenRequestExecutionCount": { "const": 0 },
    "freezeManifestHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "version": { "type": "string", "pattern": "^1\\.12\\.[0-9]+$" },
    "laneCounts": { "type": "object", "additionalProperties": false, "required": ["PHOTO_ONLY", "PHOTO_PLUS_VISIBLE_MARKINGS", "BARCODE_OR_MODEL"], "properties": { "PHOTO_ONLY": { "const": 8 }, "PHOTO_PLUS_VISIBLE_MARKINGS": { "const": 4 }, "BARCODE_OR_MODEL": { "const": 2 } } },
    "primaryPurposeCounts": { "type": "object", "additionalProperties": false, "required": ["PERSONAL_BUY", "RESALE", "WHATS_IT_WORTH", "MARKETPLACE_LISTING"], "properties": { "PERSONAL_BUY": { "const": 4 }, "RESALE": { "const": 4 }, "WHATS_IT_WORTH": { "const": 3 }, "MARKETPLACE_LISTING": { "const": 3 } } },
    "analysisPurposeCounts": { "type": "object", "additionalProperties": false, "required": ["PERSONAL_BUY", "RESALE", "WHATS_IT_WORTH", "MARKETPLACE_LISTING"], "properties": { "PERSONAL_BUY": { "const": 7 }, "RESALE": { "const": 7 }, "WHATS_IT_WORTH": { "const": 6 }, "MARKETPLACE_LISTING": { "const": 6 } } }
  }
}
