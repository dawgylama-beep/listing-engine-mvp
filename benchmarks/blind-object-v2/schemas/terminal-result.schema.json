{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blind-object-v2/terminal-result.schema.json",
  "title": "Blind Object Benchmark V2 sealed terminal result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resultRecordType", "requestId", "requestHash", "launchScopeHash", "resultId", "resultRootName", "invocationId", "consentHash", "reservationHash", "productSourceHead", "productSourceVersion", "executorSourceHead", "executorVersion", "executionProfileHash", "executionProfileIdentityHash", "pricingProfileHash", "pricingProfileIdentityHash", "costEnvelopeHash", "physicalSubmissionIdentity", "submissionState", "terminalState", "startedAt", "completedAt", "elapsedDurationMs", "handlerStatus", "sanitizedTerminalResponseEnvelope", "responseDiagnostics", "providerAttemptTelemetry", "providerIdentities", "modelIdentity", "callCeilingTelemetry", "costEntry", "governorProof", "cognitiveStateIdentity", "experienceRecord", "experienceRecordHash", "terminalEvidence", "errorStage", "errorCategory", "canonicalResponseHash", "recordHash"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "resultRecordType": { "const": "BENCHMARK_TERMINAL_RESULT" },
    "requestId": { "type": "string" },
    "requestHash": { "$ref": "#/$defs/hash" },
    "launchScopeHash": { "$ref": "#/$defs/hash" },
    "resultId": { "type": "string", "pattern": "^result-[a-f0-9]{48}$" },
    "resultRootName": { "type": "string", "pattern": "^result-root-[a-f0-9]{48}$" },
    "invocationId": { "type": "string" },
    "consentHash": { "$ref": "#/$defs/hash" },
    "reservationHash": { "$ref": "#/$defs/hash" },
    "productSourceHead": { "type": "string" },
    "productSourceVersion": { "const": "1.12.13" },
    "executorSourceHead": { "type": "string" },
    "executorVersion": { "const": "1.12.16" },
    "executionProfileHash": { "$ref": "#/$defs/hash" },
    "executionProfileIdentityHash": { "$ref": "#/$defs/hash" },
    "pricingProfileHash": { "$ref": "#/$defs/hash" },
    "pricingProfileIdentityHash": { "$ref": "#/$defs/hash" },
    "costEnvelopeHash": { "$ref": "#/$defs/hash" },
    "physicalSubmissionIdentity": { "type": "string" },
    "submissionState": { "enum": ["TERMINAL", "UNKNOWN_AFTER_SUBMISSION"] },
    "terminalState": { "type": "string" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "elapsedDurationMs": { "type": "number", "minimum": 0 },
    "handlerStatus": { "type": ["integer", "null"] },
    "sanitizedTerminalResponseEnvelope": { "type": "object" },
    "responseDiagnostics": {}, "providerAttemptTelemetry": { "type": "array" }, "providerIdentities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/publicIdentity" } }, "modelIdentity": { "$ref": "#/$defs/publicIdentity" }, "callCeilingTelemetry": {}, "costEntry": {}, "governorProof": {}, "cognitiveStateIdentity": { "type": "string" }, "experienceRecord": {}, "experienceRecordHash": { "type": "string" }, "terminalEvidence": {}, "errorStage": { "type": "string" }, "errorCategory": { "type": "string" },
    "canonicalResponseHash": { "$ref": "#/$defs/hash" },
    "recordHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "publicIdentity": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]{0,78}[A-Za-z0-9])?$" }
  }
}
